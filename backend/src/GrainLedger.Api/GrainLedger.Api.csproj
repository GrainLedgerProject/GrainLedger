<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data/Sql/InitialSchema.sql" LogicalName="GrainLedger.Data.Sql.InitialSchema.sql" />
    <EmbeddedResource Include="Data/Sql/InitialReferenceData.sql" LogicalName="GrainLedger.Data.Sql.InitialReferenceData.sql" />
    <EmbeddedResource Include="Data/Sql/InitialConstraints.sql" LogicalName="GrainLedger.Data.Sql.InitialConstraints.sql" />
    <EmbeddedResource Include="Data/Sql/BlendApprovalReservation.sql" LogicalName="GrainLedger.Data.Sql.BlendApprovalReservation.sql" />
    <EmbeddedResource Include="Data/Sql/ContainerPreparation.sql" LogicalName="GrainLedger.Data.Sql.ContainerPreparation.sql" />
    <InternalsVisibleTo Include="GrainLedger.Api.IntegrationTests" />
  </ItemGroup>
</Project>
