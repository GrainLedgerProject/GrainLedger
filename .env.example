# Local examples only; replace placeholders in your uncommitted .env.
# Docker Compose uses POSTGRES_PASSWORD for privileged local admin grainledger,
# never for runtime. Existing database volumes keep their current credentials.
# Single quotes preserve literal characters such as $ and #.
POSTGRES_PASSWORD='replace-with-a-local-development-password'

# Pre-create both logins using README provisioning SQL. Migration owner needs
# CONNECT, CREATE ON DATABASE grainledger and USAGE, CREATE ON SCHEMA public;
# Identity EF history lives in public. No membership between migration and
# runtime roles is required. Existing installations need existing object owner
# or deliberate administrator-reviewed ownership migration, not automatic rewrites.
# Migration credential is for --migrate only; production app must not receive it.
ConnectionStrings__GrainLedgerMigration='Host=localhost;Port=5433;Database=grainledger;Username=grainledger_migration;Password=replace-with-migration-password'
# Runtime login: pre-created, restricted, no owner/elevated role membership.
ConnectionStrings__GrainLedger='Host=localhost;Port=5433;Database=grainledger;Username=grainledger_runtime;Password=replace-with-runtime-password'
Ledger__RuntimeRole='grainledger_runtime'
# --migrate updates Identity, Catalog, Capture and Ledger; it does not seed data.
# Never point Development migration at production or teammate Supabase/database.
# Normal startup uses runtime connection only, validates restrictions, never migrates.

Authentication__Google__ClientId=''
Authentication__Google__ClientSecret=''
Bootstrap__AdminEmail=''

# JWT for email/password API login. Generate a random key (>=32 characters), never VITE_.
Authentication__Jwt__SigningKey=''
Authentication__Jwt__Issuer='GrainLedger'
Authentication__Jwt__Audience='GrainLedger.Api'

# SMTP sends verification/reset OTP emails. Supply credentials from your mail provider.
Mail__FromAddress=''
Mail__FromName='GrainLedger'
Mail__Smtp__Host=''
Mail__Smtp__Port='587'
Mail__Smtp__Username=''
Mail__Smtp__Password=''
Mail__Smtp__UseStartTls='true'

# Used by explicit Development --seed-dev and --seed-ledger commands; never Production.
DevelopmentSeed__Password=''
