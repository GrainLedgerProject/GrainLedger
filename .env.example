# Shared local configuration for Docker Compose and the .NET backend.
# Single quotes preserve literal characters such as $ and # in secrets.
POSTGRES_PASSWORD='replace-with-a-local-development-password'
ConnectionStrings__GrainLedger='Host=localhost;Port=5433;Database=grainledger;Username=grainledger;Password=replace-with-a-local-development-password'
Authentication__Google__ClientId=''
Authentication__Google__ClientSecret=''
Bootstrap__AdminEmail=''

# JWT for email/password API login. Generate a random key (>=32 characters), never VITE_.
Authentication__Jwt__SigningKey=''
Authentication__Jwt__Issuer='GrainLedger'
Authentication__Jwt__Audience='GrainLedger.Api'

# SMTP sends verification/reset OTP emails. Supply credentials from your mail provider.
Mail__FromAddress=''
Mail__FromName='GrainLedger'
Mail__Smtp__Host=''
Mail__Smtp__Port='587'
Mail__Smtp__Username=''
Mail__Smtp__Password=''
Mail__Smtp__UseStartTls='true'

# Only used by the explicit Development --seed-dev command; never used in Production.
DevelopmentSeed__Password=''
