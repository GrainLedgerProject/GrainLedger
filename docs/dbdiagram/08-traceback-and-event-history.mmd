erDiagram
    %% Live catalog snapshot 2026-10-19. Exact type aliases: varchar(n)=character varying(n); timestamptz=timestamp with time zone.
    %% NN = NOT NULL; NULL = nullable. PK/FK mark catalog constraints; FK labels are exact constraint names.

    %% capture.business_events — full table
    capture_business_events {
        uuid id PK "NN"
        uuid company_id FK "NULL"
        uuid actor_id FK "NULL"
        varchar(60) event_type "NN"
        timestamptz occurred_at "NN"
        timestamptz recorded_at "NN"
        uuid correlation_id "NN"
        jsonb payload "NN"
    }
    %% identity.audit_events — reference only; full fields in owning diagram
    identity_audit_events {
        bigint Id PK "NN"
        uuid ActorUserId "NULL"
        uuid SubjectUserId "NULL"
        varchar(100) Action "NN"
        jsonb DetailsJson "NN"
        timestamptz OccurredAt "NN"
        text IpAddress "NULL"
    }
    %% identity.organizations — reference only; full fields in owning diagram
    identity_organizations {
        uuid Id PK "NN"
    }
    %% identity.users — reference only; full fields in owning diagram
    identity_users {
        uuid Id PK "NN"
    }
    %% ledger.events — full table
    ledger_events {
        uuid id PK "NN"
        text kind "NN"
        uuid actor_id FK "NN"
        uuid operation_id FK "NULL"
        uuid lot_id FK "NULL"
        jsonb details "NN"
        timestamptz occurred_at "NN"
    }
    %% ledger.lots — reference only; full fields in owning diagram
    ledger_lots {
        uuid id PK "NN"
    }
    %% ledger.operations — reference only; full fields in owning diagram
    ledger_operations {
        uuid id PK "NN"
    }

    identity_organizations o|..o{ capture_business_events : "fk_events_company"
    identity_users o|..o{ capture_business_events : "fk_events_actor"
    identity_users ||..o{ ledger_events : "events_actor_id_fkey"
    ledger_lots o|..o{ ledger_events : "events_lot_id_fkey"
    ledger_operations o|..o{ ledger_events : "events_operation_id_fkey"
