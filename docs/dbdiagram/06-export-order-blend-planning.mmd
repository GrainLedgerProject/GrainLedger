erDiagram
    %% NN = NOT NULL; NULL = nullable. Composite FKs and indexes are in DBML.
    export_orders {
        uuid id PK "NN"
        uuid company_id FK "NN"
        varchar(60) code "NN"
        uuid market_id FK "NN"
        uuid commodity_id FK "NN"
        numeric(20,6) required_mass_kg "NN"
        date shipping_from "NN"
        date shipping_to "NN"
        uuid created_by FK "NN"
        timestamptz created_at "NN"
    }
    order_specifications {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid order_id FK "NN"
        integer version_no "NN"
        timestamptz recorded_at "NN"
    }
    specification_limits {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid specification_id FK "NN"
        uuid attribute_id FK "NN"
        numeric(24,12) min_value "NULL"
        numeric(24,12) max_value "NULL"
    }
    containers {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid order_id FK "NN"
        varchar(60) internal_code "NN"
        varchar(40) physical_number "NULL"
        varchar(60) seal_number "NULL"
        numeric(20,6) target_mass_kg "NN"
        varchar(32) status "NN; PLANNED LOADING CLOSED"
        timestamptz closed_at "NULL"
    }
    blend_plans {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid container_id FK "NN"
        uuid specification_id FK "NN"
        integer version_no "NN"
        varchar(32) status "NN; DRAFT PROPOSED APPROVED REJECTED IN_EXECUTION EXECUTED STALE CANCELLED"
        boolean execution_authorized "NN"
        varchar(32) search_outcome "NN; PENDING FOUND SEARCH_EXHAUSTED INVALID_INPUT"
        varchar(100) algorithm_version "NN"
        uuid requested_by FK "NN"
        timestamptz created_at "NN"
    }
    plan_items {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid plan_id FK "NN"
        uuid position_id FK "NN"
        numeric(20,6) planned_mass_kg "NN"
    }
    plan_findings {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid plan_id FK "NN"
        uuid assessment_id FK "NULL"
        uuid substance_id FK "NULL"
        uuid attribute_id FK "NULL"
        varchar(60) constraint_code "NN"
        text explanation "NN"
    }
    finding_lots {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid finding_id FK "NN"
        uuid lot_id FK "NN"
    }
    assessments {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid container_id FK "NN"
        uuid plan_id FK "NULL"
        uuid loading_id FK "NULL"
        uuid mrl_version_id FK "NULL"
        uuid safety_margin_policy_id FK "NN"
        varchar(32) purpose "NN; PROPOSE REVIEW LOADING CLOSE"
        varchar(32) verdict "NN; PASS FAIL INCOMPLETE"
        numeric(24,12) safety_margin "NN"
        varchar(32) margin_mode "NN; RELATIVE_FRACTION ABSOLUTE_MG_KG"
        uuid assessed_by FK "NULL"
        timestamptz assessed_at "NN"
        jsonb basis_snapshot "NN"
        varchar(128) basis_hash "NN"
        text explanation "NULL"
    }
    assessment_bounds {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid assessment_id FK "NN"
        uuid bound_id FK "NN"
        numeric(20,6) evaluated_mass_kg "NN"
    }
    assessment_quality {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid assessment_id FK "NN"
        uuid quality_value_id FK "NN"
        numeric(24,12) evaluated_value "NN"
        varchar(30) unit "NN"
        jsonb calculation_basis "NN"
    }
    plan_reviews {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid plan_id FK "NN"
        uuid assessment_id FK "NN"
        uuid reviewed_by FK "NN"
        varchar(32) decision "NN; APPROVE REJECT"
        varchar(32) review_scope "NN; ALL_REMAINING OUTPUT_ONLY"
        text reason "NULL"
        timestamptz reviewed_at "NN"
    }
    plan_output_allocations {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid plan_id FK "NN"
        uuid position_id FK "NN"
        uuid output_id FK "NN"
        numeric(20,6) assigned_kg "NN"
    }
    stock_reservations {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid plan_id FK "NN"
        uuid position_id FK "NN"
        uuid plan_item_id FK "NULL"
        uuid plan_output_id FK "NULL"
        varchar(32) purpose "NN; INPUT OUTPUT"
        numeric(20,6) reserved_kg "NN"
        numeric(20,6) consumed_kg "NN"
        numeric(20,6) released_kg "NN"
        timestamptz created_at "NN"
    }
    reservation_events {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid reservation_id FK "NN"
        uuid event_id FK "NN"
        integer line_no "NN"
        uuid reverses_event_id FK,UK "NULL"
        uuid movement_id FK,UK "NULL"
        uuid correction_request_id FK "NULL"
        varchar(32) kind "NN; RESERVE CONSUME RELEASE REVERSE_CONSUME"
        numeric(20,6) mass_kg "NN"
    }
