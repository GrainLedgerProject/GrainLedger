erDiagram
    %% Live catalog snapshot 2026-10-19. Exact type aliases: varchar(n)=character varying(n); timestamptz=timestamp with time zone.
    %% NN = NOT NULL; NULL = nullable. PK/FK mark catalog constraints; FK labels are exact constraint names.

    %% capture.business_events — reference only; full fields in owning diagram
    capture_business_events {
        uuid id PK "NN"
    }
    %% capture.code_counters — full table
    capture_code_counters {
        uuid company_id PK "NN"
        varchar(3) kind PK "NN"
        varchar(32) scope PK "NN"
        bigint next_value "NN"
    }
    %% capture.crop_seasons — full table
    capture_crop_seasons {
        uuid id PK "NN"
        uuid company_id FK "NN"
        text name "NN"
        date starts_on "NN"
        date ends_on "NN"
        uuid created_by FK "NULL"
        integer version "NN"
        boolean is_deleted "NN"
    }
    %% capture.farmers — full table
    capture_farmers {
        uuid id PK "NN"
        uuid company_id FK "NN"
        varchar(40) code "NN"
        text name "NN"
        text contact "NULL"
        timestamptz created_at "NN"
        uuid created_by FK "NULL"
        integer version "NN"
        boolean is_deleted "NN"
        bigint code_number "NULL"
    }
    %% capture.offline_operations — full table
    capture_offline_operations {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid submitted_by FK "NN"
        varchar(100) device_id "NN"
        uuid client_operation_id "NN"
        varchar(128) payload_hash "NN"
        jsonb payload "NN"
        timestamptz captured_at "NN"
        jsonb capture_geojson "NULL"
        timestamptz received_at "NN"
        varchar(32) status "NN"
        uuid applied_event_id FK "NULL"
        jsonb result_payload "NULL"
        text conflict_reason "NULL"
    }
    %% capture.plot_seasons — full table
    capture_plot_seasons {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid plot_id FK "NN"
        uuid season_id FK "NN"
        text rice_variety "NN"
        uuid created_by FK "NULL"
        integer version "NN"
        boolean is_deleted "NN"
    }
    %% capture.plots — full table
    capture_plots {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid farmer_id FK "NN"
        varchar(40) code "NN"
        jsonb boundary_geojson "NN"
        numeric(24,12) area_ha "NN"
        uuid created_by FK "NULL"
        integer version "NN"
        boolean is_deleted "NN"
    }
    %% capture.procurement_items — full table
    capture_procurement_items {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid procurement_id FK "NN"
        integer line_no "NN"
        uuid plot_season_id FK "NN"
        numeric(20,6) net_mass_kg "NN"
        numeric(24,12) measured_value "NN"
        varchar(20) measured_unit "NN"
        numeric(24,12) moisture_percent "NN"
    }
    %% capture.procurements — full table
    capture_procurements {
        uuid id PK "NN"
        uuid company_id FK "NN"
        varchar(40) code "NN"
        uuid farmer_id FK "NN"
        uuid collection_site_id "NN"
        uuid received_by FK "NN"
        timestamptz received_at "NN"
        varchar(32) status "NN"
        uuid event_id FK "NULL"
        text receiving_workflow "NULL"
    }
    %% capture.source_lots — full table
    capture_source_lots {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid lot_id "NN"
        uuid procurement_item_id FK "NN"
    }
    %% capture.spray_declarations — full table
    capture_spray_declarations {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid plot_season_id FK "NN"
        date applied_on "NN"
        uuid recorded_by FK "NN"
        timestamptz recorded_at "NN"
        text evidence_ref "NULL"
    }
    %% capture.spray_items — full table
    capture_spray_items {
        uuid id PK "NN"
        uuid company_id FK "NN"
        uuid declaration_id FK "NN"
        text product_name "NULL"
        uuid substance_id FK "NULL"
        numeric(24,12) rate "NULL"
        varchar(40) rate_unit "NULL"
    }
    %% catalog.active_substances — reference only; full fields in owning diagram
    catalog_active_substances {
        uuid id PK "NN"
    }
    %% identity.organizations — reference only; full fields in owning diagram
    identity_organizations {
        uuid Id PK "NN"
    }
    %% identity.users — reference only; full fields in owning diagram
    identity_users {
        uuid Id PK "NN"
    }

    capture_business_events o|..o| capture_offline_operations : "fk_operations_event"
    capture_business_events o|..o| capture_procurements : "fk_procurements_event"
    capture_crop_seasons ||..o{ capture_plot_seasons : "fk_plot_seasons_company_season"
    capture_farmers ||..o{ capture_plots : "fk_plots_company_farmer"
    capture_farmers ||..o{ capture_procurements : "fk_procurements_company_farmer"
    capture_plot_seasons ||..o{ capture_procurement_items : "fk_procurement_items_company_plot_season"
    capture_plot_seasons ||..o{ capture_spray_declarations : "fk_spray_declarations_company_plot_season"
    capture_plots ||..o{ capture_plot_seasons : "fk_plot_seasons_company_plot"
    capture_procurement_items ||..o| capture_source_lots : "fk_source_lots_company_item"
    capture_procurements ||..o{ capture_procurement_items : "fk_procurement_items_company_procurement"
    capture_spray_declarations ||..o{ capture_spray_items : "fk_spray_items_company_declaration"
    catalog_active_substances o|..o{ capture_spray_items : "fk_spray_items_substance"
    identity_organizations ||..o{ capture_crop_seasons : "fk_crop_seasons_company"
    identity_organizations ||..o{ capture_farmers : "fk_farmers_company"
    identity_organizations ||..o{ capture_offline_operations : "fk_operations_company"
    identity_organizations ||..o{ capture_plot_seasons : "fk_plot_seasons_company"
    identity_organizations ||..o{ capture_plots : "fk_plots_company"
    identity_organizations ||..o{ capture_procurements : "fk_procurements_company"
    identity_organizations ||..o{ capture_spray_declarations : "fk_spray_declarations_company"
    identity_organizations ||..o{ capture_spray_items : "fk_spray_items_company"
    identity_users o|..o{ capture_crop_seasons : "fk_crop_seasons_created_by"
    identity_users o|..o{ capture_farmers : "fk_farmers_created_by"
    identity_users o|..o{ capture_plot_seasons : "fk_plot_seasons_created_by"
    identity_users o|..o{ capture_plots : "fk_plots_created_by"
    identity_users ||..o{ capture_offline_operations : "fk_operations_user"
    identity_users ||..o{ capture_procurements : "fk_procurements_received_by"
    identity_users ||..o{ capture_spray_declarations : "fk_spray_declarations_recorded_by"
