  "landing": {
    "heroHeadline": "Every kilogram accounted for.",
    "heroSubheadline": "GrainLedger records the mass flow from smallholder paddy fields to export containers on an append-only custody ledger — helping agribusinesses prove origin, clear MRL tests, and trace instantly.",
    "ctaSignIn": "Sign In to System",
    "ctaExplore": "Explore Platform",
    "corePromises": {
      "title": "Three Pillars of the GrainLedger Custody Chain",
      "col1Title": "Mass-Balance Ledger",
      "col1Desc": "Every drying, milling, sorting, and blending step enforces conservation laws under strict tolerances. Unbalanced variances are rejected outright.",
      "col2Title": "Precise Bidirectional Traceback",
      "col2Desc": "When an adverse lab result occurs, trace forward to hold affected containers and trace backward to locate contributing farm plots.",
      "col3Title": "Market-Specific MRL Compliance",
      "col3Desc": "Full compliance engine for EU (EC 396/2005), US (EPA 40 CFR), Japan (MHLW Positive List), Korea, Codex, and Vietnam with conservative safety margins."
    },
    "audiences": {
      "title": "Who Does GrainLedger Serve?",
      "millTitle": "Rice Mills & Processors",
      "millDesc": "Provide contract drying, silo storage, milling, and bagging across multiple customer companies with audit-proof mass reconciliation.",
      "customerTitle": "Exporters & Trading Houses",
      "customerDesc": "Isolated multi-tenant custody of lots, direct farmer network monitoring, and blend plan simulation before container packing.",
      "complianceTitle": "QA & Export Operations",
      "complianceDesc": "Real-time MRL residue control per lot, instant HOLD locking upon risk detection, and automated compliance dossiers before customs clearance."
    },
    "howItWorks": {
      "title": "Mass Journey: 5 Closed Steps",
      "step1": "Procurement & Field Weighing",
      "step1Desc": "Weigh wet paddy at farm gate, measure moisture, seal representative samples, and record GPS coordinates offline.",
      "step2": "Intake & Drying",
      "step2Desc": "Receive paddy at facility, dry down to 14% moisture, record accurate moisture loss, and store in silos by owner.",
      "step3": "Milling & Fractionation",
      "step3Desc": "Fractionate into head rice, brokens, bran, and husks. Propagate processing factors and lineage mass proportions.",
      "step4": "Compliant Blending Simulation",
      "step4Desc": "Algorithm calculates optimal blend formulas satisfying broken percentage, moisture, and chemical residues with safety margins.",
      "step5": "Container Packing & Sealing",
      "step5Desc": "Approve formulation, verify physical loading, lock tamper-evident bolt seals, and freeze immutable compliance dossiers."
    },
    "complianceNotice": "GrainLedger strictly adheres to the Mass Balance chain-of-custody model defined in ISO 22095:2020. The platform accounts for mass proportions and does not make Identity-Preserved claims once grains are commingled in industrial silos.",
