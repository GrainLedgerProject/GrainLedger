{
  "name": "grainledger",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "grainledger",
      "workspaces": [
        "apps/*"
      ]
    },
    "apps/mobile": {
      "name": "@grainledger/mobile"
    },
    "apps/web": {
      "name": "@grainledger/web"
    },
    "node_modules/@grainledger/mobile": {
      "resolved": "apps/mobile",
      "link": true
    },
    "node_modules/@grainledger/web": {
      "resolved": "apps/web",
      "link": true
    }
  }
}
